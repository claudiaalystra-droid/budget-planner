<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Budget Planner</title>
  <style>
    :root {
      --blue: #2563eb;
      --blue-dark: #1d4ed8;
      --blue-light: #eff6ff;
      --ink: #172554;
      --muted: #64748b;
      --line: #e2e8f0;
      --green: #059669;
      --red: #e11d48;
      --surface: #ffffff;
      --background: #f5f8ff;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: var(--background);
      color: var(--ink);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    }

    .topbar {
      color: white;
      background: linear-gradient(120deg, #1d4ed8, #3b82f6);
      padding: 28px 20px 70px;
    }

    .topbar-inner, main {
      width: min(1120px, 100%);
      margin: 0 auto;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-icon {
      display: grid;
      width: 44px;
      height: 44px;
      place-items: center;
      border-radius: 14px;
      background: rgba(255,255,255,.18);
      font-size: 23px;
    }

    h1 { margin: 0; font-size: 23px; }
    .topbar p { margin: 6px 0 0; color: #dbeafe; font-size: 14px; }

    main {
      padding: 0 20px 40px;
      margin-top: -42px;
    }

    .summary {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin-bottom: 20px;
    }

    .card, .panel {
      background: var(--surface);
      border: 1px solid #e8eef8;
      border-radius: 18px;
      box-shadow: 0 8px 24px rgba(30, 64, 175, .06);
    }

    .card { padding: 20px; }
    .card-label { color: var(--muted); font-size: 13px; }
    .card-value { margin-top: 10px; font-size: clamp(20px, 3vw, 28px); font-weight: 750; }
    .card-icon { float: right; font-size: 22px; }
    .income { color: var(--green); }
    .expense { color: var(--red); }
    .balance { color: var(--blue); }

    .layout {
      display: grid;
      grid-template-columns: 350px 1fr;
      gap: 20px;
      align-items: start;
    }

    .panel { padding: 22px; }
    .panel h2 { margin: 0 0 18px; font-size: 17px; }
    label { display: block; margin: 14px 0 7px; color: #334155; font-size: 13px; font-weight: 600; }

    input, select {
      width: 100%;
      padding: 11px 12px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: white;
      color: var(--ink);
      font: inherit;
      outline: none;
    }

    input:focus, select:focus {
      border-color: #60a5fa;
      box-shadow: 0 0 0 3px #dbeafe;
    }

    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

    button {
      border: 0;
      border-radius: 10px;
      cursor: pointer;
      font: inherit;
      font-weight: 650;
    }

    .submit {
      width: 100%;
      margin-top: 20px;
      padding: 12px;
      color: white;
      background: var(--blue);
    }
    .submit:hover { background: var(--blue-dark); }

    .right-column { display: grid; gap: 20px; }
    .chart-wrap { height: 240px; position: relative; }
    canvas { width: 100%; height: 100%; }

    .section-heading {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-bottom: 14px;
    }
    .section-heading h2 { margin: 0; }
    .period { color: var(--muted); font-size: 12px; }

    .transactions { display: grid; gap: 10px; }
    .transaction {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 13px 0;
      border-bottom: 1px solid #f1f5f9;
    }
    .transaction:last-child { border-bottom: 0; padding-bottom: 0; }
    .transaction-info { display: flex; align-items: center; gap: 12px; min-width: 0; }
    .transaction-icon {
      display: grid;
      flex: 0 0 42px;
      width: 42px;
      height: 42px;
      place-items: center;
      border-radius: 13px;
      background: var(--blue-light);
      font-size: 19px;
    }
    .transaction-title { font-weight: 650; overflow-wrap: anywhere; }
    .transaction-meta { margin-top: 4px; color: var(--muted); font-size: 12px; }
    .transaction-right { text-align: right; white-space: nowrap; }
    .transaction-amount { font-weight: 700; }
    .delete {
      margin-top: 5px;
      padding: 3px 7px;
      color: var(--muted);
      background: transparent;
      font-size: 12px;
    }
    .delete:hover { color: var(--red); background: #fff1f2; }

    .empty { padding: 24px 10px; color: var(--muted); text-align: center; font-size: 14px; }
    .note { margin: 14px 2px 0; color: var(--muted); font-size: 12px; line-height: 1.5; }

    @media (max-width: 800px) {
      .layout { grid-template-columns: 1fr; }
      .summary { gap: 10px; }
      .card { padding: 16px; }
    }

    @media (max-width: 520px) {
      .topbar { padding: 23px 16px 62px; }
      main { padding-right: 14px; padding-left: 14px; }
      .summary { grid-template-columns: 1fr; }
      .card-value { margin-top: 5px; }
      .panel { padding: 18px; }
      .form-row { grid-template-columns: 1fr; gap: 0; }
    }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <div class="brand">
        <div class="brand-icon" aria-hidden="true">💸</div>
        <div>
          <h1>Budget Planner</h1>
          <p>Catat uang masuk dan keluar dengan lebih mudah.</p>
        </div>
      </div>
    </div>
  </header>

  <main>
    <section class="summary" aria-label="Ringkasan keuangan">
      <article class="card">
        <span class="card-icon" aria-hidden="true">📈</span>
        <div class="card-label">Total pemasukan</div>
        <div class="card-value income" id="totalIncome">Rp0</div>
      </article>
      <article class="card">
        <span class="card-icon" aria-hidden="true">📉</span>
        <div class="card-label">Total pengeluaran</div>
        <div class="card-value expense" id="totalExpense">Rp0</div>
      </article>
      <article class="card">
        <span class="card-icon" aria-hidden="true">💰</span>
        <div class="card-label">Sisa saldo</div>
        <div class="card-value balance" id="balance">Rp0</div>
      </article>
    </section>

    <div class="layout">
      <section class="panel">
        <h2>Tambah transaksi</h2>
        <form id="transactionForm">
          <div class="form-row">
            <div>
              <label for="type">Jenis transaksi</label>
              <select id="type">
                <option value="expense">Pengeluaran</option>
                <option value="income">Pemasukan</option>
              </select>
            </div>
            <div>
              <label for="date">Tanggal</label>
              <input id="date" type="date" required />
            </div>
          </div>

          <label for="category">Kategori</label>
          <select id="category"></select>

          <label for="description">Keterangan</label>
          <input id="description" type="text" placeholder="Contoh: Makan siang" maxlength="60" required />

          <label for="amount">Jumlah (Rp)</label>
          <input id="amount" type="number" min="1" step="1" placeholder="Contoh: 25000" required />

          <button class="submit" type="submit">＋ Simpan transaksi</button>
        </form>
        <p class="note">Data disimpan di browser perangkat ini. Data tidak otomatis tersinkron ke perangkat lain.</p>
      </section>

      <div class="right-column">
        <section class="panel">
          <div class="section-heading">
            <h2>Grafik keuangan</h2>
            <span class="period">7 hari terakhir</span>
          </div>
          <div class="chart-wrap">
            <canvas id="chart" aria-label="Grafik pemasukan dan pengeluaran tujuh hari terakhir"></canvas>
          </div>
        </section>

        <section class="panel">
          <div class="section-heading">
            <h2>Riwayat transaksi</h2>
            <span class="period" id="transactionCount">0 transaksi</span>
          </div>
          <div class="transactions" id="transactions"></div>
        </section>
      </div>
    </div>
  </main>

  <script>
    const STORAGE_KEY = "budget-planner-transactions-v1";
    const categories = {
      expense: ["Makan", "Transportasi", "Belanja", "Tagihan", "Hiburan", "Kesehatan", "Pendidikan", "Lainnya"],
      income: ["Gaji", "Freelance", "Bonus", "Hadiah", "Investasi", "Lainnya"]
    };

    const form = document.getElementById("transactionForm");
    const typeInput = document.getElementById("type");
    const categoryInput = document.getElementById("category");
    const dateInput = document.getElementById("date");
    const descriptionInput = document.getElementById("description");
    const amountInput = document.getElementById("amount");
    let transactions = loadTransactions();

    function localDateString(date = new Date()) {
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, "0");
      const day = String(date.getDate()).padStart(2, "0");
      return `${year}-${month}-${day}`;
    }

    function loadTransactions() {
      try {
        const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");
        return Array.isArray(saved) ? saved : [];
      } catch {
        return [];
      }
    }

    function saveTransactions() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(transactions));
    }

    function rupiah(value) {
      return new Intl.NumberFormat("id-ID", {
        style: "currency",
        currency: "IDR",
        maximumFractionDigits: 0
      }).format(value);
    }

    function updateCategories() {
      categoryInput.replaceChildren(
        ...categories[typeInput.value].map(name => {
          const option = document.createElement("option");
          option.value = name;
          option.textContent = name;
          return option;
        })
      );
    }

    function formatDate(dateString) {
      const date = new Date(`${dateString}T00:00:00`);
      return new Intl.DateTimeFormat("id-ID", {
        day: "numeric", month: "short", year: "numeric"
      }).format(date);
    }

    function render() {
      const income = transactions
        .filter(item => item.type === "income")
        .reduce((sum, item) => sum + item.amount, 0);
      const expense = transactions
        .filter(item => item.type === "expense")
        .reduce((sum, item) => sum + item.amount, 0);

      document.getElementById("totalIncome").textContent = rupiah(income);
      document.getElementById("totalExpense").textContent = rupiah(expense);
      document.getElementById("balance").textContent = rupiah(income - expense);
      document.getElementById("transactionCount").textContent =
        `${transactions.length} transaksi`;

      const list = document.getElementById("transactions");
      list.replaceChildren();

      const sorted = [...transactions].sort((a, b) =>
        b.date.localeCompare(a.date) || b.createdAt - a.createdAt
      );

      if (sorted.length === 0) {
        const empty = document.createElement("div");
        empty.className = "empty";
        empty.textContent = "Belum ada transaksi. Tambahkan transaksi pertama Anda.";
        list.append(empty);
      } else {
        for (const item of sorted) {
          const row = document.createElement("div");
          row.className = "transaction";

          const info = document.createElement("div");
          info.className = "transaction-info";

          const icon = document.createElement("div");
          icon.className = "transaction-icon";
          icon.textContent = item.type === "income" ? "💵" : "🧾";

          const text = document.createElement("div");
          const title = document.createElement("div");
          title.className = "transaction-title";
          title.textContent = item.description;
          const meta = document.createElement("div");
          meta.className = "transaction-meta";
          meta.textContent = `${item.category} · ${formatDate(item.date)}`;
          text.append(title, meta);
          info.append(icon, text);

          const right = document.createElement("div");
          right.className = "transaction-right";
          const amount = document.createElement("div");
          amount.className = `transaction-amount ${item.type === "income" ? "income" : "expense"}`;
          amount.textContent = `${item.type === "income" ? "+" : "−"}${rupiah(item.amount)}`;

          const remove = document.createElement("button");
          remove.className = "delete";
          remove.type = "button";
          remove.textContent = "Hapus";
          remove.setAttribute("aria-label", `Hapus transaksi ${item.description}`);
          remove.addEventListener("click", () => {
            transactions = transactions.filter(transaction => transaction.id !== item.id);
            saveTransactions();
            render();
          });

          right.append(amount, remove);
          row.append(info, right);
          list.append(row);
        }
      }

      drawChart();
    }

    function drawChart() {
      const canvas = document.getElementById("chart");
      const ctx = canvas.getContext("2d");
      const rect = canvas.getBoundingClientRect();
      const width = Math.max(300, rect.width);
      const height = Math.max(180, rect.height);
      const dpr = window.devicePixelRatio || 1;

      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.scale(dpr, dpr);
      ctx.clearRect(0, 0, width, height);

      const days = [];
      const today = new Date();
      for (let i = 6; i >= 0; i--) {
        const date = new Date(today);
        date.setDate(today.getDate() - i);
        const key = localDateString(date);
        const dayItems = transactions.filter(item => item.date === key);
        days.push({
          label: new Intl.DateTimeFormat("id-ID", { weekday: "short" }).format(date),
          income: dayItems.filter(item => item.type === "income").reduce((sum, item) => sum + item.amount, 0),
          expense: dayItems.filter(item => item.type === "expense").reduce((sum, item) => sum + item.amount, 0)
        });
      }

      const pad = { top: 24, right: 12, bottom: 34, left: 12 };
      const chartHeight = height - pad.top - pad.bottom;
      const chartWidth = width - pad.left - pad.right;
      const max = Math.max(1, ...days.flatMap(day => [day.income, day.expense]));
      const groupWidth = chartWidth / days.length;
      const barWidth = Math.min(20, groupWidth * 0.26);

      ctx.font = "11px system-ui";
      ctx.textAlign = "center";

      days.forEach((day, index) => {
        const center = pad.left + groupWidth * index + groupWidth / 2;
        const incomeHeight = (day.income / max) * chartHeight;
        const expenseHeight = (day.expense / max) * chartHeight;

        ctx.fillStyle = "#3b82f6";
        ctx.beginPath();
        ctx.roundRect(center - barWidth - 2, pad.top + chartHeight - incomeHeight, barWidth, Math.max(incomeHeight, day.income ? 2 : 0), 5);
        ctx.fill();

        ctx.fillStyle = "#f87171";
        ctx.beginPath();
        ctx.roundRect(center + 2, pad.top + chartHeight - expenseHeight, barWidth, Math.max(expenseHeight, day.expense ? 2 : 0), 5);
        ctx.fill();

        ctx.fillStyle = "#64748b";
        ctx.fillText(day.label, center, height - 10);
      });

      ctx.textAlign = "left";
      ctx.fillStyle = "#3b82f6";
      ctx.fillRect(pad.left, 5, 9, 9);
      ctx.fillStyle = "#475569";
      ctx.fillText("Pemasukan", pad.left + 14, 14);
      ctx.fillStyle = "#f87171";
      ctx.fillRect(pad.left + 100, 5, 9, 9);
      ctx.fillStyle = "#475569";
      ctx.fillText("Pengeluaran", pad.left + 114, 14);
    }

    typeInput.addEventListener("change", updateCategories);

    form.addEventListener("submit", event => {
      event.preventDefault();
      const amount = Number(amountInput.value);
      if (!Number.isFinite(amount) || amount <= 0) {
        amountInput.setCustomValidity("Masukkan jumlah yang lebih besar dari 0.");
        amountInput.reportValidity();
        return;
      }
      amountInput.setCustomValidity("");

      transactions.push({
        id: crypto.randomUUID ? crypto.randomUUID() : `${Date.now()}-${Math.random()}`,
        type: typeInput.value,
        date: dateInput.value,
        category: categoryInput.value,
        description: descriptionInput.value.trim(),
        amount,
        createdAt: Date.now()
      });

      saveTransactions();
      form.reset();
      typeInput.value = "expense";
      dateInput.value = localDateString();
      updateCategories();
      render();
    });

    window.addEventListener("resize", drawChart);
    dateInput.value = localDateString();
    updateCategories();
    render();
  </script>
</body>
</html>